{
  "name": "agent-genesis",
  "version": "0.1.0",
  "description": "Every project begins here. Genesis reads your codebase and builds a tailored AI engineering team.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "genesis": "./bin/genesis.js",
    "genesis-mcp": "./bin/genesis-mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agents",
    "opencode",
    "codebase-analysis",
    "agent-team",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/user/genesis"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.8.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^17.4.2",
    "handlebars": "^4.7.8",
    "openai": "^4.82.0",
    "ora": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
